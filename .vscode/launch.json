{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: start screen (no scan)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=rs-disk-analyzer"],
        "filter": { "name": "rs-disk-analyzer", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "Debug: scan home folder",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=rs-disk-analyzer"],
        "filter": { "name": "rs-disk-analyzer", "kind": "bin" }
      },
      "args": ["--scan", "${userHome}"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "Debug: scan ./src (small, fast)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=rs-disk-analyzer"],
        "filter": { "name": "rs-disk-analyzer", "kind": "bin" }
      },
      "args": ["--scan", "${workspaceFolder}/src"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "Debug: scan a folder (prompt)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=rs-disk-analyzer"],
        "filter": { "name": "rs-disk-analyzer", "kind": "bin" }
      },
      "args": ["--scan", "${input:folderToScan}"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "Debug: unit tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run", "--bin=rs-disk-analyzer"],
        "filter": { "name": "rs-disk-analyzer", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug (Windows, CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/rs-disk-analyzer.exe",
      "args": ["--scan", "${workspaceFolder}/src"],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1",
        "WGPU_BACKEND": "dx12"
      },
      "preLaunchTask": "cargo build"
    }
  ],
  "inputs": [
    {
      "id": "folderToScan",
      "type": "promptString",
      "description": "Folder to scan at startup",
      "default": "${workspaceFolder}"
    }
  ]
}
